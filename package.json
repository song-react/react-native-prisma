{
  "name": "@prisma/react-native",
  "version": "7.9.1",
  "description": "Synchronous Prisma 7 client for React Native and Expo SQLite",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "bin": {
    "prisma-react-native": "scripts/prepare-client.cjs"
  },
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./expo-sqlite": {
      "react-native": "./src/expo-sqlite.ts",
      "import": {
        "types": "./lib/typescript/module/expo-sqlite.d.ts",
        "default": "./lib/module/expo-sqlite.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/expo-sqlite.d.ts",
        "default": "./lib/commonjs/expo-sqlite.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "scripts/patch-prisma-runtime.cjs",
    "scripts/prepare-client.cjs",
    "react-native.config.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare": "bob build",
    "postinstall": "node ./scripts/patch-prisma-runtime.cjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "prisma",
    "sqlite",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/song-react/react-native-prisma.git"
  },
  "author": "Oscar Franco <ospfranco@gmail.com> (https://github.com/ospfranco)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/song-react/react-native-prisma/issues"
  },
  "homepage": "https://github.com/song-react/react-native-prisma#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@prisma/client": "7.9.1",
    "@prisma/driver-adapter-utils": "7.9.1",
    "expo": "58.0.0-canary-20260812-27f94d4",
    "expo-sqlite": "58.0.0-canary-20260812-27f94d4",
    "prisma": "7.9.1",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-builder-bob": "0.40.13",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@prisma/client": "^7.9.1",
    "expo": ">=52.0.0",
    "expo-sqlite": ">=15.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@prisma/driver-adapter-utils": "7.9.1"
  }
}

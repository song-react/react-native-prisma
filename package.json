{
  "name": "@prisma/react-native",
  "version": "7.9.1",
  "description": "Synchronous Prisma 7 client for React Native and Expo SQLite",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "lib/module/index.js",
  "bin": {
    "prisma-react-native": "scripts/prepare-client.cjs"
  },
  "exports": {
    ".": {
      "react-native": "./lib/module/index.js",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./expo-sqlite": {
      "react-native": "./lib/module/expo-sqlite.js",
      "import": {
        "types": "./lib/typescript/module/expo-sqlite.d.ts",
        "default": "./lib/module/expo-sqlite.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/expo-sqlite.d.ts",
        "default": "./lib/commonjs/expo-sqlite.js"
      }
    },
    "./native": {
      "react-native": "./lib/module/native.js",
      "import": {
        "types": "./lib/typescript/module/native.d.ts",
        "default": "./lib/module/native.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/native.d.ts",
        "default": "./lib/commonjs/native.js"
      }
    }
  },
  "files": [
    "lib",
    "scripts",
    "expo-module.config.json",
    "PrismaReactNative.podspec",
    "ios",
    "native/include",
    "native/PrismaQueryCompiler.xcframework",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./scripts/patch-prisma-runtime.cjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "prisma",
    "sqlite",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/song-react/react-native-prisma.git"
  },
  "author": "Oscar Franco <ospfranco@gmail.com> (https://github.com/ospfranco)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/song-react/react-native-prisma/issues"
  },
  "homepage": "https://github.com/song-react/react-native-prisma#readme",
  "dependencies": {
    "@prisma/driver-adapter-utils": "7.9.1",
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "@prisma/client": "^7.9.1",
    "expo": ">=52.0.0",
    "expo-sqlite": ">=15.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
